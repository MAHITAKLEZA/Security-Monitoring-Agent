# Secrets — never commit application passwords or tokens
# (real credential files are ignored; only the *.example template is tracked)
secrets/*
!secrets/.gitignore
!secrets/*.example
*.env
.env

# Dashboard-added sites (may contain a WordPress username)
sites.json

# Generated scan output and baselines
reports/
state/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
