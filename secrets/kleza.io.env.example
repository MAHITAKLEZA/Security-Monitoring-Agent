# WordPress credentials for the authenticated scan and inside malware scan.
#
# HOW TO USE:
#   1. Copy this file to  secrets/<site>.env   (e.g. secrets/kleza.io.env)
#   2. Fill in the values below.
#   3. Reference it from config.yaml:  checks.wordpress.app_password_file: secrets/<site>.env
#      (or add the site from the dashboard's "Add Website" form, which writes this file for you)
#
# This .env.example file is safe to commit. Real secret files (secrets/*.env) are git-ignored
# and must NEVER be committed.

username=your-wordpress-admin-username
password=xxxx xxxx xxxx xxxx xxxx xxxx
